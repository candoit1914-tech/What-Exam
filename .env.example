# ── Server ──────────────────────────────────────────────────────────────
# Backend API server (serves /api, webhooks, and reports)
PORT=3000
# Public URL of this backend (used for webhook URL and report links in messages)
APP_URL=http://localhost:3000
# Frontend dashboard server (serves the admin SPA). API base is APP_URL.
FRONTEND_PORT=8080
# Public URL of the frontend dashboard (shown on the backend landing page)
FRONTEND_URL=http://localhost:8080
# Comma-separated browser origins allowed to call the API (loopback is allowed by default)
CORS_ORIGIN=

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────────────
# From developers.facebook.com/apps -> your app -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=your_graph_api_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=any_random_secret_string_you_choose
# App secret from developers.facebook.com/apps -> your app -> Settings -> Basic.
# REQUIRED for the webhook: every event is verified against x-hub-signature-256
# using this secret, so student replies cannot be spoofed. If unset, webhook
# POSTs are rejected (the exam bot will not receive student answers).
WHATSAPP_APP_SECRET=your_meta_app_secret
# The webhook URL you register with Meta must be:
#   https://your-app.example.com/webhook/whatsapp
#
# Required for first contact outside the customer service window: approved template.
# Meta blocks free-form texts outside the customer service window (delivery
# may be rejected). The student must reply to open the 24h customer service window.
#  - WHATSAPP_TEMPLATE_NAME:   name of the approved invitation template
#  - WHATSAPP_TEMPLATE_LANGUAGE: e.g. en
#  - WHATSAPP_TEMPLATE_PARAMS:  comma-separated values filling {{1}}, {{2}}, ...
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_PARAMS=

# ── AI (any OpenAI-compatible endpoint) ─────────────────────────────────
# The primary is AshnaAI, a multi-model gateway that speaks the OpenAI
# chat-completions contract, so it needs only a base URL and a key. Groq,
# OpenRouter, Ollama (http://localhost:11434/v1) and OpenAI itself work the
# same way - change AI_BASE_URL/AI_MODEL and nothing else.
#
# gpt-5-mini, not the flagship gpt-6-astra. A single paper costs ~80 AI calls,
# so per-call price multiplies quickly and a small balance will not survive a
# flagship. Measured on a PDF-extraction block through this gateway, the same 8
# questions cost 3275 total tokens on gpt-5-mini against 4923 on astra. Raise
# AI_MODEL to gpt-5.4 or gpt-6-astra if question quality on hard papers needs
# the ceiling; glm-5.3-flash and gemini-2.5-flash are cheaper still.
AI_BASE_URL=https://api.ashna.ai/v1/api
AI_API_KEY=your_ai_api_key
AI_MODEL=gpt-5-mini
# Reasoning effort for gpt-5*/gpt-6*/o-series models: none | low | medium |
# high. This is the dominant cost term at this call volume. 'none' is accepted
# by this gateway and measured slightly cheaper than 'low' (3213 vs 3275 tokens
# on a PDF block), but the margin is small, so 'low' ships as the measured
# quality/cost balance. Raise to 'medium'/'high' if extraction quality on a
# hard paper degrades. Ignored by non-reasoning models, which keep using
# temperature. Set to '' to omit the field entirely.
AI_REASONING_EFFORT=low
# Max time (ms) each AI call may take before it aborts. A gateway in front of a
# flagship reasoning model adds its own latency, so leave headroom above the
# provider's own timeout. PDF question extraction overrides this with
# AI_BLOCK_TIMEOUT_MS below.
AI_TIMEOUT_MS=120000
# How many question-generation batches may be in flight at once. This dominates
# how long a paper takes: one batch of 10 questions takes ~19s, so a hardcoded
# concurrency of 2 serialized a 15-call paper into 8 waves. Measured on AshnaAI,
# 4 concurrent batches finished in 29.5s and 8 in 29.6s, with zero 429s at either
# level. Rate limits are handled by retry-with-backoff in the AI client, so lower
# this only if YOUR account actually sees 429s.
AI_GENERATE_CONCURRENCY=6
# Per-block budget (ms) for PDF question extraction. A block that overruns is
# retried once and then skipped with a visible warning, so this must clear your
# slowest block with headroom. Measured 28s-89s on a 17-page paper; the 90s
# ceiling that used to be hardcoded turned ordinary slow responses into
# silently missing questions. A flagship model behind a gateway can exceed
# that, so this is set well above the observed range.
AI_BLOCK_TIMEOUT_MS=360000
# How many PDF extraction blocks may run at once. Every block asks for up to
# 16k output tokens, so this is really a token-throughput knob: too high and the
# provider answers 429 and blocks are dropped from the import. Lower it (2-3) on
# a tight rate limit or behind a shared gateway, raise it (5-6) if your
# endpoint has headroom.
AI_BLOCK_CONCURRENCY=3
# Set to true only when AI_MODEL accepts image input. Photo answers then get
# AI-vision grading; otherwise they are flagged for manual review on the
# dashboard.
#
# VERIFY THIS PER MODEL. A gateway routes attachments by what the underlying
# provider supports, and when a model cannot take images it substitutes a text
# note instead of failing. The call then SUCCEEDS and the app grades a
# handwritten answer it never saw, with no error anywhere. So this must be
# tested, not assumed, whenever AI_MODEL changes.
#
# Verified true for gpt-5-mini, gpt-6-astra, gpt-4o-mini and glm-5.3-flash
# through this gateway: each read a random token out of a generated test image.
# The secondary NVIDIA Nemotron does NOT support images and is already excluded
# from the photo-read path in ai.js - do not remove that exclusion.
AI_VISION=false
# ── Voice notes: a SEPARATE provider from the chat provider above ────────
# Required for voice-note answers, and it is the ONLY way to get them. The chat
# provider cannot do this job: AI_BASE_URL here is a chat gateway whose catalog
# has no speech model, /audio/transcriptions returns 404, and every chat model
# handed an `input_audio` part replies 200 with no transcript - which the app
# would then grade as silence. So audio gets its own endpoint and its own key.
#
# Any OpenAI-compatible /audio/transcriptions endpoint works: OpenAI, Groq, or a
# self-hosted faster-whisper. Only the key is required - the base URL defaults
# to OpenAI and the model to whisper-1. With this blank, transcribeAudio()
# fails loudly and flags the note for manual review instead of guessing.
AI_TRANSCRIBE_API_KEY=
AI_TRANSCRIBE_BASE_URL=https://api.openai.com/v1
AI_TRANSCRIBE_MODEL=whisper-1

# ── Secondary AI provider (Claude/Fable) ────────────────────────────────
# OPTIONAL second OpenAI-compatible provider. When both CLAUDE_API_KEY and
# CLAUDE_BASE_URL are set, every AI call is raced against the primary and the
# first successful response wins (lower latency; both providers are billed).
# Leave empty to use only the primary. NEVER commit a real key — it lives in
# .env only.
CLAUDE_API_KEY=
CLAUDE_BASE_URL=
CLAUDE_MODEL=
CLAUDE_TIMEOUT_MS=

# ── Tertiary AI provider (xAI / Grok) ──────────────────────────────────
# OPTIONAL third OpenAI-compatible provider. When XAI_API_KEY is set, it's
# raced against the primary and secondary for faster responses. Grok is
# particularly fast at structured JSON extraction.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3
XAI_TIMEOUT_MS=

# ── Puter.js (AI Vision for photo answers) ──────────────────────────────
# OPTIONAL — Puter.js API key for vision-based photo answer reading.
# Get a free API key at https://puter.com
# When set, photo answers (handwritten/drawn) are automatically read using
# Puter.js vision instead of requiring manual review.
PUTER_API_KEY=

# ── ElevenLabs (premium voiceover for advert) ────────────────────────────
# OPTIONAL — for generating humanlike voiceover for the video advert.
# Get your API key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice ID from https://elevenlabs.io/voice-library (default: Rachel)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Exam defaults ───────────────────────────────────────────────────────
PASS_PERCENTAGE=50
DEFAULT_DURATION_MINUTES=30
# Display the answer key + grade after the exam ends? (never sent mid-exam)
SEND_ANSWER_KEY=true
# Allow the admin "resend result" button (send-report)
ALLOW_RESEND_RESULTS=true
# Maximum concurrent student deliveries
SEND_CONCURRENCY=2
# Maximum queued retries of failed student delivery
SEND_RETRIES=3
# Retry delay setting in milliseconds
SEND_RETRY_DELAY_MS=5000
# Send a PDF certificate with completed exam results?
SEND_CERTIFICATES=true
# Delay between outgoing WhatsApp messages (milliseconds)
WHATSAPP_SEND_INTERVAL_MS=2000
# Interval for finalizing overdue exam sessions (milliseconds)
STALE_SESSION_CLEANUP_MS=60000
# Global cap on attempts per student per exam. 0 = unlimited; an individual
# exam's max_attempts setting overrides this.
MAX_ATTEMPTS=0
# Optional: override the logo baked into result certificates
# CERT_LOGO_PATH=./src/public/oktek-logo.png
# Set to 1 for verbose PDF-extraction diagnostics in the logs
# PDF_DIAG=0

# ── Admin dashboard ─────────────────────────────────────────────────────
# Password that signs you into the admin dashboard. All /api routes require
# a login token. If unset, a random password is generated at every boot and
# is not printed to logs. Set this explicitly for a stable login.
ADMIN_PASSWORD=choose_a_strong_password

# ── Database ────────────────────────────────────────────────────────────
DB_PATH=./data/exams.db
# ⚠ ON RENDER, LEAVE THESE UNSET AND YOU WILL LOSE DATA. The values below are
# the ephemeral container default: Render deletes the container filesystem on
# every deploy and restart, wiping the database (every student, session and
# graded answer) plus uploaded photos and voice notes, then re-seeds a fresh
# exam so the loss looks like a normal boot. Mount a Render disk at
# /opt/render/project/src/data and set BOTH variables to match:
#   DB_PATH=/opt/render/project/src/data/exams.db
#   UPLOADS_DIR=/opt/render/project/src/data/uploads
# render.yaml in the repo declares the disk. The server prints a loud warning
# at boot while these are unset.
UPLOADS_DIR=./data/uploads
# Auto-seed the starter exam when the DB is empty at boot? (set false once
# you've built your real exam and want a clean slate on every fresh deploy)
SEED_ON_BOOT=true

# Run npm run config:check to identify missing settings without printing secrets.
# This local check does not validate credentials, template approval or reachability.
