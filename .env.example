# ── Server ──────────────────────────────────────────────────────────────
# Backend API server (serves /api, webhooks, and reports)
PORT=3000
# Public URL of this backend (used for webhook URL and report links in messages)
APP_URL=http://localhost:3000
# Frontend dashboard server (serves the admin SPA). API base is APP_URL.
FRONTEND_PORT=8080
# Public URL of the frontend dashboard (shown on the backend landing page)
FRONTEND_URL=http://localhost:8080
# Comma-separated EXTRA browser origins allowed to call the API cross-origin.
# Loopback and the shipped dashboard (https://what-exam.vercel.app, which
# calls the API at APP_URL) are allowed without this — only add origins of
# dashboards you host YOURSELF somewhere else. A missing origin shows up in
# the browser as "Failed to fetch" and in the server log as "[cors] blocked
# origin ...".
CORS_ORIGIN=

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────────────
# From developers.facebook.com/apps -> your app -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=your_graph_api_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=any_random_secret_string_you_choose
# App secret from developers.facebook.com/apps -> your app -> Settings -> Basic.
# REQUIRED for the webhook: every event is verified against x-hub-signature-256
# using this secret, so student replies cannot be spoofed. If unset, webhook
# POSTs are rejected (the exam bot will not receive student answers).
WHATSAPP_APP_SECRET=your_meta_app_secret
# The webhook URL you register with Meta must be:
#   https://your-app.example.com/webhook/whatsapp
#
# Required for first contact outside the customer service window: approved template.
# Meta blocks free-form texts outside the customer service window (delivery
# may be rejected). The student must reply to open the 24h customer service window.
#  - WHATSAPP_TEMPLATE_NAME:   name of the approved invitation template
#  - WHATSAPP_TEMPLATE_LANGUAGE: e.g. en
#  - WHATSAPP_TEMPLATE_PARAMS:  comma-separated values filling {{1}}, {{2}}, ...
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_PARAMS=
# Optional but recommended for paid exams, since a student may not have replied
# to the invitation before opening Paystack. Create/approve a Utility template
# with body variables {{1}} exam title, {{2}} price, {{3}} full checkout URL.
WHATSAPP_PAYMENT_TEMPLATE_NAME=
# The payment webhook can open the exam without waiting for a WhatsApp reply
# only when this approved template is available. Its body variables are {{1}}
# exam title, {{2}} first question plus answer choices, {{3}} duration minutes.
WHATSAPP_PAID_START_TEMPLATE_NAME=

# ── AI: OpenAI ──────────────────────────────────────────────────────────
# OpenAI powers AI exam generation, PDF extraction, marking and (with vision
# enabled) photo/figure reading. Create an API key at platform.openai.com/api-keys
# and add billing to the API project. A ChatGPT subscription is separate from
# API usage and does not automatically provide API credits.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# gpt-4o-mini does not use reasoning_effort. Leave blank for this model.
AI_REASONING_EFFORT=
# Optional OpenAI-compatible service: set AI_PROVIDER=compatible and provide
# these values to use it instead of OpenAI.
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=your_compatible_provider_api_key
# AI_MODEL=your-model-name
# Max time (ms) each AI call may take before it aborts. PDF question extraction overrides this with
# AI_BLOCK_TIMEOUT_MS below.
AI_TIMEOUT_MS=120000
# How many question-generation batches may be in flight at once. Rate limits are
# handled by retry-with-backoff; lower this if your API project reaches its limit.
AI_GENERATE_CONCURRENCY=6
# Per-block budget (ms) for PDF question extraction. Slow blocks are retried
# with smaller chunks, and anything unrecoverable is reported to the admin.
AI_BLOCK_TIMEOUT_MS=600000
# How many PDF extraction blocks may run at once. Every block asks for up to
# 16k output tokens, so this is really a token-throughput knob: too high and the
# provider answers 429 and blocks are dropped from the import. Lower it (2-3) on
# a tight rate limit or behind a shared gateway, raise it (5-6) if your
# endpoint has headroom.
AI_BLOCK_CONCURRENCY=4
# Set to true only when the selected model accepts image input. Photo answers get
# AI-vision grading; otherwise they are flagged for manual review on the
# dashboard.
#
# gpt-4o-mini supports image input. Set false only to disable AI photo marking.
AI_VISION=true
# How many pages of an uploaded PDF get the vision "find the figure" rescue
# when the page scan found no diagram. 0 (the default) means every page that
# asks for one gets its own vision pass — no page is left unrescued just
# because the paper is long. Raise the number only to cap spend on huge scans.
# OpenAI is asked first when it is configured.
AI_VISION_PAGE_LIMIT=0
# ── Voice notes: OpenAI Whisper ─────────────────────────────────────────
# Chat models do not transcribe audio through /chat/completions. Voice notes use
# Whisper on this separate audio endpoint and can share OPENAI_API_KEY above.
#
# Any OpenAI-compatible /audio/transcriptions endpoint works: OpenAI, Groq, or a
# self-hosted faster-whisper. Only the key is required - the base URL defaults
# to OpenAI and the model to whisper-1. With this blank, transcribeAudio()
# fails loudly and flags the note for manual review instead of guessing.
#
# Leave this blank to use OPENAI_API_KEY for voice notes.
AI_TRANSCRIBE_API_KEY=
AI_TRANSCRIBE_BASE_URL=https://api.openai.com/v1
AI_TRANSCRIBE_MODEL=whisper-1

# Optional: select a different model for AI photo reading.
# OPENAI_VISION_MODEL=gpt-4o-mini

# ── Secondary AI provider (Claude/Fable) ────────────────────────────────
# OPTIONAL second OpenAI-compatible provider. Providers are tried only when
# the one before them fails. With OpenAI primary, this is a fallback; with
# AI_PROVIDER=compatible, OpenAI is tried after this provider. Leave empty to
# skip. NEVER commit a real key — it lives in .env only.
CLAUDE_API_KEY=your_nvidia_api_key
CLAUDE_BASE_URL=https://integrate.api.nvidia.com/v1
CLAUDE_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
CLAUDE_TIMEOUT_MS=

# ── Tertiary AI provider (xAI / Grok) ──────────────────────────────────
# OPTIONAL last-resort OpenAI-compatible provider, tried only after every
# provider above it has failed. Grok is particularly fast at structured JSON
# extraction.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3
XAI_TIMEOUT_MS=

# ── Puter.js (AI Vision for photo answers) ──────────────────────────────
# OPTIONAL — Puter.js API key for vision-based photo answer reading.
# Get a free API key at https://puter.com
# When set, photo answers (handwritten/drawn) are automatically read using
# Puter.js vision instead of requiring manual review.
PUTER_API_KEY=

# ── ElevenLabs (premium voiceover for advert) ────────────────────────────
# OPTIONAL — for generating humanlike voiceover for the video advert.
# Get your API key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice ID from https://elevenlabs.io/voice-library (default: Rachel)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Exam defaults ───────────────────────────────────────────────────────
PASS_PERCENTAGE=50
DEFAULT_DURATION_MINUTES=30
# Display the answer key + grade after the exam ends? (never sent mid-exam)
SEND_ANSWER_KEY=true
# Allow the admin "resend result" button (send-report)
ALLOW_RESEND_RESULTS=true
# Maximum concurrent student deliveries
SEND_CONCURRENCY=2
# Maximum queued retries of failed student delivery
SEND_RETRIES=3
# Retry delay setting in milliseconds
SEND_RETRY_DELAY_MS=5000
# Send a PDF certificate with completed exam results?
SEND_CERTIFICATES=true
# Delay between outgoing WhatsApp messages (milliseconds)
WHATSAPP_SEND_INTERVAL_MS=2000
# Interval for finalizing overdue exam sessions (milliseconds)
STALE_SESSION_CLEANUP_MS=60000
# Global cap on attempts per student per exam. 0 = unlimited; an individual
# exam's max_attempts setting overrides this.
MAX_ATTEMPTS=0
# Optional: override the logo baked into result certificates
# CERT_LOGO_PATH=./src/public/oktek-logo.png
# Set to 1 for verbose PDF-extraction diagnostics in the logs
# PDF_DIAG=0

# ── Admin dashboard ─────────────────────────────────────────────────────
# Password that signs you into the admin dashboard. All /api routes require
# a login token. If unset, a random password is generated at every boot and
# is not printed to logs. Set this explicitly for a stable login.
ADMIN_PASSWORD=choose_a_strong_password

# ── Database ────────────────────────────────────────────────────────────
DB_PATH=./data/exams.db
# ⚠ ON RENDER, LEAVE THESE UNSET AND YOU WILL LOSE DATA. The values below are
# the ephemeral container default: Render deletes the container filesystem on
# every deploy and restart, wiping the database (every student, session and
# graded answer) plus uploaded photos and voice notes, then re-seeds a fresh
# exam so the loss looks like a normal boot. On a PAID plan, mount a Render
# disk at /opt/render/project/src/data and set BOTH variables to match:
#   DB_PATH=/opt/render/project/src/data/exams.db
#   UPLOADS_DIR=/opt/render/project/src/data/uploads
# render.yaml in the repo declares the disk. On the FREE plan disks do not
# exist — use the GitHub backup below instead. The server prints a loud
# warning at boot while storage is unprotected.
UPLOADS_DIR=./data/uploads
# Auto-seed the starter exam when the DB is empty at boot? (set false once
# you've built your real exam and want a clean slate on every fresh deploy)
SEED_ON_BOOT=true

# ── GitHub backup (Render FREE plan — no disk available) ────────────────
# Persistence when a disk cannot be mounted: the database and uploads are
# pushed to a PRIVATE GitHub repo on an interval and restored automatically
# at boot, before the app opens the database. OFF unless BOTH are set.
# Setup:
#   1. Create a PRIVATE repo, e.g. you/what-exam-backup. NEVER point this at
#      the public app repo — the backup contains student answers and photos.
#   2. GitHub -> Settings -> Developer settings -> Personal access tokens ->
#      Fine-grained: scope it to that repo only, Contents: Read and write.
#   3. In Render, set:
#        BACKUP_GITHUB_TOKEN=github_pat_...
#        BACKUP_GITHUB_REPO=you/what-exam-backup
# Optional: BACKUP_GITHUB_BRANCH=backup (default), BACKUP_INTERVAL_MS=300000
# (5 min; floor 60000). With these set the boot warning changes from
# "DATA LOSS RISK" to "GitHub backup is ON".
# BACKUP_GITHUB_TOKEN=
# BACKUP_GITHUB_REPO=

# ── Paystack (paid exams) ─────────────────────────────────────────────────
# Only read when the admin creates an exam as PAID. A free exam never touches
# these, so leave them blank until you actually price a paper — sending a paid
# exam with no key is refused with a clear error rather than a dead link.
# Keys: dashboard.paystack.co -> Settings -> API Keys & Webhooks (sk_test_...
# while testing). The secret key signs the webhook and is sent as a Bearer
# token when a checkout is initialized or a reference is verified.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Ghana accounts settle in cedi; the price is sent to Paystack in pesewas.
# PAYSTACK_CURRENCY=GHS
# Base URL override, for a proxy or a mock gateway in tests.
# PAYSTACK_BASE_URL=https://api.paystack.co
# Where the browser lands after checkout (optional: Paystack's own page if blank).
# PAYSTACK_CALLBACK_URL=https://your-app.example.com/
# Where Paystack should POST charge events. Register this in the dashboard
# (Settings -> Webhooks) alongside the WhatsApp webhook — it must be public for
# payments to unlock instantly; without it a student is verified on their next
# reply instead:
#   https://your-app.example.com/webhook/paystack

# Run npm run config:check to identify missing settings without printing secrets.
# This local check does not validate credentials, template approval or reachability.
