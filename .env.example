# ── Server ──────────────────────────────────────────────────────────────
# Backend API server (serves /api, webhooks, and reports)
PORT=3000
# Public URL of this backend (used for webhook URL and report links in messages)
APP_URL=http://localhost:3000
# Frontend dashboard server (serves the admin SPA). API base is APP_URL.
FRONTEND_PORT=8080
# Public URL of the frontend dashboard (shown on the backend landing page)
FRONTEND_URL=http://localhost:8080
# Comma-separated browser origins allowed to call the API (loopback is allowed by default)
CORS_ORIGIN=

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────────────
# From developers.facebook.com/apps -> your app -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=your_graph_api_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=any_random_secret_string_you_choose
# App secret from developers.facebook.com/apps -> your app -> Settings -> Basic.
# REQUIRED for the webhook: every event is verified against x-hub-signature-256
# using this secret, so student replies cannot be spoofed. If unset, webhook
# POSTs are rejected (the exam bot will not receive student answers).
WHATSAPP_APP_SECRET=your_meta_app_secret
# The webhook URL you register with Meta must be:
#   https://your-app.example.com/webhook/whatsapp
#
# Required for first contact outside the customer service window: approved template.
# Meta blocks free-form texts outside the customer service window (delivery
# may be rejected). The student must reply to open the 24h customer service window.
#  - WHATSAPP_TEMPLATE_NAME:   name of the approved invitation template
#  - WHATSAPP_TEMPLATE_LANGUAGE: e.g. en
#  - WHATSAPP_TEMPLATE_PARAMS:  comma-separated values filling {{1}}, {{2}}, ...
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_PARAMS=

# ── AI (any OpenAI-compatible endpoint) ─────────────────────────────────
# OpenAI, Groq, OpenRouter, Ollama (http://localhost:11434/v1), etc.
AI_BASE_URL=https://opencode.ai/zen/v1
AI_API_KEY=your_ai_api_key
AI_MODEL=mimo-v2.5-free
# Max time (ms) each AI call may take before it aborts. Slow endpoints (e.g.
# large NVIDIA models) need more than the 60s default. PDF question extraction
# overrides this with AI_BLOCK_TIMEOUT_MS below.
AI_TIMEOUT_MS=120000
# Per-block budget (ms) for PDF question extraction. A block that overruns is
# retried once and then skipped with a visible warning, so this must clear your
# slowest block with headroom. Measured 28s-89s on a 17-page paper; the 90s
# ceiling that used to be hardcoded turned ordinary slow responses into
# silently missing questions.
AI_BLOCK_TIMEOUT_MS=240000
# Set to true only when AI_MODEL accepts image input (e.g. gpt-4o).
# Photo answers then get AI-vision grading; otherwise they are flagged
# for manual review on the dashboard.
AI_VISION=false

# ── Secondary AI provider (Claude/Fable) ────────────────────────────────
# OPTIONAL second OpenAI-compatible provider. When both CLAUDE_API_KEY and
# CLAUDE_BASE_URL are set, every AI call is raced against the primary and the
# first successful response wins (lower latency; both providers are billed).
# Leave empty to use only the primary. NEVER commit a real key — it lives in
# .env only.
CLAUDE_API_KEY=
CLAUDE_BASE_URL=
CLAUDE_MODEL=
CLAUDE_TIMEOUT_MS=

# ── Tertiary AI provider (xAI / Grok) ──────────────────────────────────
# OPTIONAL third OpenAI-compatible provider. When XAI_API_KEY is set, it's
# raced against the primary and secondary for faster responses. Grok is
# particularly fast at structured JSON extraction.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3
XAI_TIMEOUT_MS=

# ── Puter.js (AI Vision for photo answers) ──────────────────────────────
# OPTIONAL — Puter.js API key for vision-based photo answer reading.
# Get a free API key at https://puter.com
# When set, photo answers (handwritten/drawn) are automatically read using
# Puter.js vision instead of requiring manual review.
PUTER_API_KEY=

# ── ElevenLabs (premium voiceover for advert) ────────────────────────────
# OPTIONAL — for generating humanlike voiceover for the video advert.
# Get your API key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice ID from https://elevenlabs.io/voice-library (default: Rachel)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Exam defaults ───────────────────────────────────────────────────────
PASS_PERCENTAGE=50
DEFAULT_DURATION_MINUTES=30
# Display the answer key + grade after the exam ends? (never sent mid-exam)
SEND_ANSWER_KEY=true
# Allow the admin "resend result" button (send-report)
ALLOW_RESEND_RESULTS=true
# Maximum concurrent student deliveries
SEND_CONCURRENCY=2
# Maximum queued retries of failed student delivery
SEND_RETRIES=3
# Retry delay setting in milliseconds
SEND_RETRY_DELAY_MS=5000
# Send a PDF certificate with completed exam results?
SEND_CERTIFICATES=true
# Delay between outgoing WhatsApp messages (milliseconds)
WHATSAPP_SEND_INTERVAL_MS=2000
# Interval for finalizing overdue exam sessions (milliseconds)
STALE_SESSION_CLEANUP_MS=60000

# ── Admin dashboard ─────────────────────────────────────────────────────
# Password that signs you into the admin dashboard. All /api routes require
# a login token. If unset, a random password is generated at every boot and
# is not printed to logs. Set this explicitly for a stable login.
ADMIN_PASSWORD=choose_a_strong_password

# ── Database ────────────────────────────────────────────────────────────
DB_PATH=./data/exams.db
# Auto-seed the starter exam when the DB is empty at boot? (set false once
# you've built your real exam and want a clean slate on every fresh deploy)
SEED_ON_BOOT=true

# Run npm run config:check to identify missing settings without printing secrets.
# This local check does not validate credentials, template approval or reachability.
